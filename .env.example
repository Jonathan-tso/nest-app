# Supabase — get these from your project at https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The anon/public key is used in the frontend only (src/supabase.jsx), not here.
# The service role key bypasses RLS and is used only in serverless functions.
# Never expose SUPABASE_SERVICE_ROLE_KEY in client-side code.
